## BASE IMAGE
FROM node:20-alpine

## WORKING DIRECTORY
WORKDIR /app

## COPY PACKAGES
COPY package*.json ./

## RUN TO INSTALL PACKAGES AND REQUIREMENTS
RUN npm ci

## COPY THEM
COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

## RUN TO CHECK
RUN npm run build

## PORT FOR FRONTEND
EXPOSE 3000

## COMMANDS
CMD ["sh", "-c", "npm start -- -H 0.0.0.0 -p ${PORT:-3000}"]